# Keep these defaults for a project-owned model volume.
OLLAMA_DATA_VOLUME=local-agentic-ai-ollama-data
OLLAMA_DATA_VOLUME_EXTERNAL=false

# Default model and context used by both CPU and GPU modes.
LOCAL_AGENT_MODEL=qwen3.5:9b-q4_K_M
LOCAL_AGENT_NUM_CTX=8192

# Set the NVIDIA GPU index used by `make compose-gpu`.
OLLAMA_CUDA_VISIBLE_DEVICES=0
